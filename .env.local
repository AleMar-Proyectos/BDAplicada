# Este archivo es solo un MODELO para ver el formato de las variables de entorno.
# Hay que crear un archivo .env en la raíz del proyecto (al lado de package.json)
# copiando este formato y completando los valores reales. El .env NO se sube al repo.

PORT=3000
NODE_ENV=development

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Supabase → Connect → Session pooler
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# API .NET (api-dotnet/MarketCar.Api)
DOTNET_API_URL=http://localhost:5080

# Intentos fallidos de login permitidos por IP cada 15 minutos
LOGIN_MAX_INTENTOS=10
